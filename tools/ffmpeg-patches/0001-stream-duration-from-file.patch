         }
+        /* Quillbinder: streams without a duration of their own (Matroska,
+         * WebM) take the duration of the file. Qt Multimedia 6.4 reads only
+         * stream durations and cannot seek in a file of duration 0. */
+        if (st->duration == AV_NOPTS_VALUE && ic->duration != AV_NOPTS_VALUE)
+            st->duration = av_rescale_q(ic->duration, AV_TIME_BASE_Q,
