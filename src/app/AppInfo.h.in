#pragma once
// Generated from CMakeLists.txt - do not edit.
#define QB_APP_NAME    "@APP_NAME@"
#define QB_APP_ID      "@APP_ID@"
#define QB_APP_VERSION "@APP_VERSION@"
// The version as people see it: the number plus the label of CMakeLists.txt
// ("0.30.0 alpha"). Only for display; compare versions with QB_APP_VERSION.
#define QB_APP_VERSION_SHOWN "@APP_VERSION_SHOWN@"
// the label alone ("beta" since 0.70.0; "" without one)
#define QB_APP_VERSION_LABEL "@APP_VERSION_LABEL@"
#define QB_RUNTIME_ID  "@APP_RUNTIME@"
// the release day of the runtime's Qt (0.80.0): System Information shows the runtime's age
#define QB_RUNTIME_DATE "@APP_RUNTIME_DATE@"
#define QB_RUNTIME_SINCE "@APP_RUNTIME_SINCE@" // the first version of this runtime: what add-ons with libraries need (Linux)
// The public project page and its release with the third-party source code (0.50).
#define QB_APP_HOMEPAGE "@APP_HOMEPAGE@"
#define QB_SOURCES_URL  "@APP_HOMEPAGE@/releases/tag/third-party-sources"
// Project folder suffix and the index file inside it.
#define QB_PROJECT_SUFFIX ".quillbinder"
#define QB_PROJECT_FILE_SUFFIX ".qbx"
#define QB_LINK_SCHEME "qb"
